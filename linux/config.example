# dgb-oracle-monitor configuration (shell syntax: KEY="value", no spaces around =)
# Copy to `config` in this directory and edit. `config` is gitignored.

# Your oracle slot and wallet
ORACLE_ID=0
ORACLE_WALLET="oracle"

# Paths
CLI_EXE="/usr/local/bin/digibyte-cli"
DATADIR="/home/digibyte/.digibyte"

# Which chains this box runs
MONITOR_TESTNET=1
MONITOR_MAINNET=1

# systemd service name for the daemon ("" if you don't run it under systemd).
# Used to detect and annotate automatic restarts (crash-class reporting).
DAEMON_SERVICE="digibyted"

# User the monitor timer runs as (must be able to run digibyte-cli against
# your datadir). Defaults to "digibyte" if unset.
#MONITOR_USER="digibyte"

# --- Alerts ---------------------------------------------------------------
# ntfy (easiest: install the ntfy app, subscribe to your topic, done).
# THE TOPIC IS A PASSWORD: anyone who knows it can read your alert stream and
# spoof alerts to you. Pick something long and random.
NTFY_SERVER="https://ntfy.sh"
NTFY_TOPIC="PICK-A-LONG-RANDOM-TOPIC-NAME"

# Telegram (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Generic webhook (optional): JSON POST {title, body, priority}
WEBHOOK_URL=""

# --- Behavior -------------------------------------------------------------
REALERT_HOURS=6          # re-send an unresolved alert this often
HEARTBEAT_ENABLED=1      # one quiet daily "all is well"
HEARTBEAT_HOUR=9         # earliest local hour for the daily heartbeat
MIN_FREE_DISK_GB=15
# A node you do not run, asked what it sees for your slot (keep at monitor cadence):
NETVIEW_URL="https://digibyte.io/api/getoracles"
NETVIEW_STALE_SECONDS=3600
# Fork detector (local getpeerinfo only). Triage thresholds, not correctness boundaries:
FORK_GAP_BLOCKS=100       # a peer "claims ahead" when its startingheight exceeds our headers by more than this
FORK_MIN_PEERS=2          # this many peers must claim ahead at once (one erroneous peer cannot set the maximum)
FORK_PROGRESS_BLOCKS=100  # headers advancing by at least this per cycle is a catch-up, not a stall
# Signing drought (chain-based, local getoraclesigners; the kit's authoritative silent-slot check):
DROUGHT_EPOCHS=36          # epochs without our slot in any bundle before paging (~1 false page per 85 days per slot at the lottery floor)
DROUGHT_SCAN_BLOCKS=100    # getoraclesigners window (Core's default; the scan walks every block under cs_main); sightings persist across runs
DROUGHT_STALL_BLOCKS=160   # newest mature bundle more than this behind the tip = no recent bundle on this node's chain (no page, no clear)
DROUGHT_STALL_WARN_SECONDS=3600  # a stall older than this raises the degraded-observation warning
DROUGHT_TESTNET=0          # the math is from mainnet; enable on testnet deliberately
